    "routeIds": ["NeedlePlacement", "LateCrosswindAttack", "LeftPitchOut"],
    "attemptsPerRoute": 20,
    "requiredAttemptCount": 60,
    "validator": "Scripts/validate_route_telemetry.py"
  },
  "claimBoundary": {
    "templateOrEngineeringRegressionIsAcceptedMeasuredCalibration": false,
    "physicsOwnerApproval": false,
    "playtestOwnerApproval": false,
    "productOwnerApproval": false,
    "acceptedMeasuredReferenceDatasetPath": null,
    "releaseReady": false,
    "disclaimer": "This policy predeclares a capture matrix, measurement-quality ceilings, comparison tolerances, and route-telemetry coverage. It does not supply measurements, approve seed coefficients, establish play feel, or close the release gate."
