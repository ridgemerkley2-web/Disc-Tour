{
  "schema": "DiscGolfTour.PhysicsMeasuredReferencePolicy.v1",
  "schemaVersion": 1,
  "policyId": "physics_measured_reference_capture_v1",
  "authority": "PREDECLARED_CAPTURE_AND_COMPARISON_PROTOCOL_NOT_ACCEPTED_MEASURED_DATA",
  "units": {
    "distance": "meters",
